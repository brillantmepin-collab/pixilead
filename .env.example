# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Scraping Google Maps ────────────────────────────────────────────────────
# Absent ou contenant "placeholder" -> mode démo (leads fictifs)
APIFY_TOKEN=your-apify-token

# ── Génération de messages IA ───────────────────────────────────────────────
# Absent ou contenant "placeholder" -> générateur de secours (templates)
OPENAI_API_KEY=your-openai-api-key

# ── Paiements Moneroo (Mobile Money + carte) ────────────────────────────────
# Clé API : https://app.moneroo.io/developers/api-keys
# Le mode test/live est déterminé par la clé elle-même, l'URL est la même.
MONEROO_SECRET_KEY=your-moneroo-secret-key

# Secret HMAC du webhook : https://app.moneroo.io/developers/webhooks
# Y déclarer l'URL : https://votre-domaine/api/webhooks/moneroo
MONEROO_WEBHOOK_SECRET=your-moneroo-webhook-secret

# Base publique de l'application, utilisée pour construire la return_url
# Moneroo. En développement : ngrok / Cloudflare Tunnel (HTTPS obligatoire).
NEXT_PUBLIC_APP_URL=https://votre-domaine
